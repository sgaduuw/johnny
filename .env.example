# Copy to .env and fill in. Loaded by the app at startup; missing
# required vars should crash loudly rather than fall back to defaults
# that would silently hide misconfiguration in production.

# --- Database ----------------------------------------------------------
# SQLAlchemy URL. SQLite for dev/homelab; Postgres at work scale.
DATABASE_URL=sqlite:///./johnny.db

# --- API auth ----------------------------------------------------------
# Bearer token shared between johnny-api and the callback plugin.
# Generate with e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
JOHNNY_API_TOKEN=change-me-to-a-long-random-string
